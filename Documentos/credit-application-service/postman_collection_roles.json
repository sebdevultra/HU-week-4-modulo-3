                            "raw": "{{base_url}}/credit-applications/my-applications",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "credit-applications",
                                "my-applications"
                            ]
                        }
                    },
                    "response": []
                },
