                            ]
                        }
                    },
                    "response": []
                },
                {
                    "name": "Create Application (Success)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status code is 201\", function () {",
                                    "    pm.response.to.have.status(201);",
                                    "});",
                                    "var jsonData = pm.response.json();",
                                    "pm.environment.set(\"current_app_id\", jsonData.id);"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{affiliate_token}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "method": "POST",
                        "header": [],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"affiliateId\": {{affiliate_id}},\n  \"requestedAmount\": 1500000,\n  \"termMonths\": 12,\n  \"purpose\": \"Testing RBAC Flow\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{base_url}}/credit-applications",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "credit-applications"
                            ]
